    "@angular/router": "^22.2.0",
    "@primeuix/themes": "^3.1.1",
    "primeflex": "^4.0.0",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
